   "source": [
    "### Customizing agent memory\n",
    "By default, agents use AgentState to manage short term memory, specifically the conversation history via a messages key.\n",
    "\n",
    "You can extend AgentState to add additional fields. Custom state schemas are passed to create_agent using the state_schema parameter."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "8325c5a9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'messages': [HumanMessage(content='Hello! DO you know who I am?', additional_kwargs={}, response_metadata={}, id='b53080f9-b28b-479e-aa6c-3113c5391561'), AIMessage(content=\"I don't have access to your personal information unless you provide your user ID. If you share your user ID, I can look up your information for you.\", additional_kwargs={}, response_metadata={'model_name': 'openai/gpt-4o-mini', 'id': 'gen-1778601719-sMeog8lyZazAVNiYCtUh', 'created': 1778601719, 'object': 'chat.completion', 'finish_reason': 'stop', 'logprobs': None, 'model_provider': 'openrouter', 'system_fingerprint': 'fp_9dda724e50'}, id='lc_run--019e1cec-76d3-7ef2-84b3-793810003cf8-0', tool_calls=[], invalid_tool_calls=[], usage_metadata={'input_tokens': 55, 'output_tokens': 32, 'total_tokens': 87, 'input_token_details': {'cache_read': 0, 'cache_creation': 0}, 'output_token_details': {'reasoning': 0}})], 'user_id': 'user_123', 'preferences': {'theme': 'dark'}}\n"
     ]
    }
   ],
   "source": [
    "from langchain.agents import create_agent, AgentState\n",
    "from langgraph.checkpoint.memory import InMemorySaver\n",
    "\n",
    "\n",
    "class CustomAgentState(AgentState):\n",
    "    user_id: str\n",
    "    preferences: dict\n",
    "\n",
    "agent = create_agent(\n",
    "    model=model,\n",
    "    tools=[get_user_info],\n",
    "    state_schema=CustomAgentState,\n",
    "    checkpointer=InMemorySaver(),\n",
    ")\n",
    "\n",
    "# Custom state can be passed in invoke\n",
    "result = agent.invoke(\n",
    "    {\n",
    "        \"messages\": [{\"role\": \"user\", \"content\": \"Hello! DO you know who I am?\"}],\n",
    "        \"user_id\": \"user_123\",\n",
    "        \"preferences\": {\"theme\": \"dark\"}\n",
    "    },\n",
    "    {\"configurable\": {\"thread_id\": \"1\"}})\n",
    "\n",
    "print(result)\n"
   ]
  },
